{
  "name": "claude",
  "description": "Anthropic Claude Code CLI agent (registry-managed)",
  "extends": null,
  "security": {
    "signal_mode": "isolated",
    "capability_elevation": false
  },
  "filesystem": {
    "allow": [
      "$HOME/.claude",
      "$HOME/.local/state/claude/locks",
      "$HOME/.cache/claude",
      "$NONO_CONFIG/profile-drafts",
      "/tmp/claude-$UID",
      "$HOME/Library/Keychains"
    ],
    "read": [
      "$NONO_PACKAGES",
      "$NONO_CONFIG/profiles"
    ],
    "write": [],
    "allow_file": [
      "$HOME/.claude.json",
      "$HOME/.claude.json.lock",
      "$HOME/.claude.lock"
    ],
    "read_file": [],
    "write_file": [],
    "deny": [],
    "bypass_protection": [
      "$HOME/Library/Keychains"
    ],
    "suppress_save_prompt": []
  },
  "groups": {
    "include": [
      "deny_credentials",
      "deny_keychains_macos",
      "deny_keychains_linux",
      "deny_browser_data_macos",
      "deny_browser_data_linux",
      "deny_macos_private",
      "deny_shell_history",
      "deny_shell_configs",
      "system_read_macos",
      "system_read_linux_core",
      "system_write_macos",
      "system_write_linux",
      "user_tools",
      "homebrew_macos",
      "homebrew_linux",
      "dangerous_commands",
      "dangerous_commands_macos",
      "dangerous_commands_linux",
      "claude_code_macos",
      "user_caches_macos",
      "node_runtime",
      "rust_runtime",
      "python_runtime",
      "vscode_macos",
      "nix_runtime",
      "git_config",
      "unlink_protection"
    ],
    "exclude": []
  },
  "network": {
    "block": false,
    "network_profile": null,
    "allow_domain": [],
    "credentials": [],
    "open_port": [],
    "listen_port": [],
    "no_proxy": [],
    "upstream_proxy": null,
    "upstream_bypass": []
  },
  "workdir": {
    "access": "readwrite"
  },
  "rollback": {
    "exclude_patterns": [
      "node_modules",
      ".next",
      "__pycache__",
      "target"
    ],
    "exclude_globs": [
      "*.tmp.[0-9]*.[0-9]*"
    ]
  },
  "open_urls": {
    "allow_origins": [
      "https://claude.ai",
      "https://claude.com",
      "https://api.anthropic.com",
      "https://platform.claude.com"
    ],
    "allow_localhost": true
  },
  "allow_launch_services": true
}
